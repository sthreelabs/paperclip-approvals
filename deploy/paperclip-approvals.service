# systemd unit for the Paperclip approvals bot (Linux). Copy to /etc/systemd/system/, edit the paths,
# then: sudo systemctl daemon-reload && sudo systemctl enable --now paperclip-approvals
# Secrets live in the env files (mode 600), never in this unit.
[Unit]
Description=Paperclip approvals bot
After=network-online.target
Wants=network-online.target

[Service]
User=paperclip-approvals
WorkingDirectory=/opt/paperclip-approvals
ExecStart=/opt/paperclip-approvals/.venv/bin/python approvals.py --env-file /etc/paperclip-approvals/secrets.env --env-file /etc/paperclip-approvals/config.env
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
