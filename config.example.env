# Non-secret settings. Copy to config.env and edit. See the docstring in approvals.py for every option.
APPROVALS_CHAT=slack
PAPERCLIP_API_URL=https://paperclip.example.com
PAPERCLIP_COMPANY_ID=00000000-0000-0000-0000-000000000000
APPROVERS_FILE=approvers.json
READER_KEY_ENV=PAPERCLIP_BOARD_KEY
APPROVALS_STATE_FILE=state.json
APPROVALS_AUDIT_FILE=audit.jsonl
APPROVALS_TZ=America/New_York
# Slack only: the channel to post in (the app must be a member)
SLACK_APPROVALS_CHANNEL=C0000000000
